    style.stroke: "#334155"
    style.fill: white
  }
  SRC: "<<system>>\nSource file system" {
    shape: rectangle
    style.stroke: "#334155"
    style.fill: white
  }
  TGT: "<<system>>\nBackup storage" {
    shape: rectangle
    style.stroke: "#334155"
    style.fill: white
