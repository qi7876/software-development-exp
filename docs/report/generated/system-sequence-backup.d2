diagram: "Accepted Job to Published Full Backup" {
  style.font-size: 44
  style.fill: white
  style.stroke: transparent
  shape: sequence_diagram
  Client: "HTTP client" {shape: person}
  API: "<<boundary>>\nAPI" {shape: rectangle}
  Jobs: "<<control>>\nJobManager / worker" {shape: rectangle}
  DB: "jobs.sqlite3" {shape: cylinder}
  Backup: "<<control>>\nbackup" {shape: rectangle}
  Repo: "Repository" {shape: cylinder}
  Client -> API: "POST /api/backups + Bearer key"
  API -> Jobs: "Validate request / submit"
  Jobs -> DB: "Commit queued job"
  API -> Client: "202 + Location + queued job" {style.stroke-dash: 5}
  Jobs -> DB: "Claim oldest queued job as running"
  Jobs -> Backup: "Execute through spawn_blocking"
  Backup -> Backup: "Walk / stream Zstd / SHA-256 / file\nsizes"
  Backup -> Repo: "Synchronize payload files and\ndirectories"
  fragment_8: alt {
    branch_8: "[Payload processing succeeded]" {
      Backup -> Repo: "Transactionally commit header and\nentries"
      Backup -> Jobs: "backup_id" {style.stroke-dash: 5}
      Jobs -> DB: "Commit succeeded result"
    }
    branch_12: "[Processing or publication failed]" {
      Backup -> Jobs: "Operation error" {style.stroke-dash: 5}
      Jobs -> DB: "Commit failed outcome"
    }
  }
  Client -> API: "GET job Location"
  API -> Jobs: "Read durable job"
  API -> Client: "200 + state / result / error" {style.stroke-dash: 5}
}
