    }
    Metadata: "<<struct>>\nUnixMetadata" {
      shape: class
      "+ uid": "u32"
      "+ gid": "u32"
      "+ mode": "u32"
      "+ atime": "FileTimestamp"
      "+ mtime": "FileTimestamp"
    }
    Stats: "<<struct>>\nBackupStats" {
