(** -- **)[*].style: {font-size: 32; bold: true; italic: false; font-color: "#1E293B"}
(** <- **)[*].style: {font-size: 32; bold: true; italic: false; font-color: "#1E293B"}
diagram: "Service Startup, Shutdown and Recovery" {
  style.font-size: 44
  style.fill: white
  style.stroke: transparent
  shape: sequence_diagram
  User: "Operator" {shape: person}
  Main: "<<control>>\nStartup" {shape: rectangle}
  Keys: "<<entity>>\nKeyring / key files" {shape: rectangle}
  Jobs: "<<control>>\nJobManager" {shape: rectangle}
  DB: "jobs.sqlite3" {shape: cylinder}
  Server: "<<boundary>>\nserver" {shape: rectangle}
  Scheduler: "<<control>>\nScheduler" {shape: rectangle}
  User -> Main: "bak -d working-directory"
  Main -> Main: "Parse flags / read config.json"
  Main -> Keys: "Load named keys and fingerprints"
  Main -> Jobs: "Open JobManager with shared Keyring"
  Jobs -> DB: "Initialize schema / fail interrupted\nrunning jobs"
  DB -> Jobs: "Terminal history and queued jobs\nretained" {style.stroke-dash: 5}
  Main -> Server: "Prepare scheduler, then bind HTTP"
  Server -> Scheduler: "Validate plans / resolve keys"
  Scheduler -> Jobs: "Initialize UTC cursors; no catch-up"
  Jobs -> DB: "Advance persisted startup minute"
  Server -> Jobs: "Run FIFO worker"
  fragment_11: "opt [Embedded console enabled]" {
    User -> Server: "Load public UI / verify selected API"
    Server -> User: "Authenticated version and key\nfingerprints" {style.stroke-dash: 5}
  }
  fragment_15: "opt [Ctrl-C or SIGTERM]" {
    User -> Server: "Request graceful shutdown"
    Server -> Scheduler: "Stop admitting scheduled work"
    Server -> Jobs: "Stop claiming; finish active operation"
    Jobs -> DB: "Persist active outcome; retain queued\nwork"
    Server -> Main: "Close database pool and exit" {style.stroke-dash: 5}
  }
}
