diagram: "Service Startup, Shutdown and Recovery" {
  style.font-size: 44
  style.fill: white
  style.stroke: transparent
  shape: sequence_diagram
  User: "Operator" {shape: person}
  Main: "<<control>>\nStartup" {shape: rectangle}
  Jobs: "<<control>>\nJobManager" {shape: rectangle}
  DB: "jobs.sqlite3" {shape: cylinder}
  Server: "<<boundary>>\nserver" {shape: rectangle}
  User -> Main: "bak -d working-directory"
  Main -> Main: "Parse flags / read config.json"
  Main -> Jobs: "Open job manager"
  Jobs -> DB: "Initialize schema / fail interrupted\nrunning jobs"
  DB -> Jobs: "Terminal history and queued jobs\nretained" {style.stroke-dash: 5}
  Main -> Server: "Bind listener and supervise worker"
  Server -> Jobs: "Run FIFO worker"
  fragment_7: "opt [Ctrl-C or SIGTERM]" {
    User -> Server: "Request graceful shutdown"
    Server -> Jobs: "Stop claiming; finish active operation"
    Jobs -> DB: "Persist active outcome; retain queued\nwork"
    Server -> Main: "Close database pool and exit" {style.stroke-dash: 5}
  }
}
